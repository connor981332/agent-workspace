# aw attach --wait waits for the lane's setup, printing each step, and ends with the result: on a
# failure, the step, the end of its log and the command that retries it, so an agent need not poll.
# req: R31
# source: plans/agent-feedback.md, item 5
# milestone: M12

workspace shop --init
! exec sh $WORK/attach.sh
stdout 'Claimed lane 01 feature-flag'
stderr 'aw: setting up lane feature-flag: '
stderr 'lane feature-flag: setup incomplete \(web\.setup failed: exit status 3, log .*web\.setup\.log\) → aw setup feature-flag'
stderr 'The end of its log:'
stderr 'not fixed yet'

exec touch .git/fixed
exec aw setup feature-flag
exec aw attach 'another one' --wait
stderr '^aw: lane another-one is set up \([0-9]+ steps\)$'
exec aw --json
json stdout .lanes[1].state working

-- attach.sh --
# Hold prepare until --wait has observed and reported it, rather than racing a short sleep.
set -eu
aw attach 'add feature flag' --wait > "$WORK/attach-out" 2> "$WORK/attach-err" &
attach_pid=$!
cleanup() {
  touch .git/release-prepare
  kill "$attach_pid" 2>/dev/null || :
}
trap cleanup EXIT HUP INT TERM
i=0
while ! grep -q 'aw: setting up lane feature-flag:' "$WORK/attach-err" 2>/dev/null; do
  if ! kill -0 "$attach_pid" 2>/dev/null || [ "$i" -ge 400 ]; then
    cat "$WORK/attach-out"
    cat "$WORK/attach-err" >&2
    echo 'attach did not report setup progress' >&2
    exit 1
  fi
  sleep 0.05
  i=$((i + 1))
done
touch .git/release-prepare
if wait "$attach_pid"; then result=0; else result=$?; fi
cat "$WORK/attach-out"
cat "$WORK/attach-err" >&2
exit "$result"
-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0

[lifecycle]
prepare = 'while [ ! -e "$AW_OWNER/.git/release-prepare" ]; do sleep 0.05; done'

[projects.web]
directory = "web"

[projects.web.lifecycle]
setup = 'test -e "$AW_OWNER/.git/fixed" || { echo not fixed yet; exit 3; }'

[projects.api]
directory = "api"
