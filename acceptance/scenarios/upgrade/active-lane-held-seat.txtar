# An upgrade with a working lane, a held seat and a hand-edited launcher: the pin moves, the edit
# stays and is reported, and the lane and its seat carry on under the new version.
# req: R18 R19 R20 R17
# source: plan M8 exit criterion
# milestone: M8

owner-may-change
workspace shop --init
exec aw attach 'one'
cd .worktrees/01
exec aw serve stack
exec sh -c 'i=0; until test -s $WORK/server.pid; do i=$((i+1)); test $i -lt 100 || exit 1; sleep 0.1; done'
cd ../..
exec sh -c 'echo "# my note" >> bin/aw'

env AW_MIRROR=$AW_NEW_MIRROR
! exec aw upgrade --to $AW_NEW_VERSION
stdout 'aw '$AW_VERSION' → '$AW_NEW_VERSION
stderr 'bin/aw was edited by hand, so aw left it alone'
stderr 'eject bin/aw'
grep '# my note' bin/aw
grep '^'$AW_NEW_VERSION'$' .aw/version
grep 'aw_'$AW_NEW_VERSION'_' .aw/lock
exec aw version
stdout '^aw '$AW_NEW_VERSION' '

cd .worktrees/01
exec aw whoami
stdout 'location +lane root'
exec aw run web true
exec aw queue --json
json stdout .resources[0].holders[0].lane_name one
exec aw stop stack
stdout 'Released stack'

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0

[projects.web]
directory = "web"

[projects.web.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["web.app"]

