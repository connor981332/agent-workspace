# Secret files that are not in Git are linked into every lane, relatively, from the owner's
# checkout, and kept out of Git, so a moved workspace keeps working and nothing is committed.
# req: R67
# source: C2 tests::t_lane_new_makes_worktree_env_and_links; C2 finding F10; C2 finding F18
# milestone: M2

workspace shop --init
exec sh -c 'printf "SECRET=1\n" > web/.env && mkdir -p web/config && printf key > web/config/master.key'
owner-snapshot
exec aw attach 'add feature flag'
exec readlink web/.worktrees/01/.env
stdout '^\.\./\.\./\.env$'
exec readlink web/.worktrees/01/config/master.key
stdout '^\.\./\.\./\.\./config/master\.key$'
exec cat web/.worktrees/01/.env
stdout 'SECRET=1'
exec git -C web/.worktrees/01 status --porcelain
! stdout .
grep '^/\.env$' web/.git/info/exclude
# A secret the owner does not have yet is simply not linked.
! exists web/.worktrees/01/.env.local

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[projects.web]
secrets = [".env", "config/master.key", ".env.local"]

[projects.api]
