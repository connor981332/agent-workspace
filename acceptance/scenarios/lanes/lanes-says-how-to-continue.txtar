# aw lanes ends with how to continue a lane no session runs in: aw resume names the lanes whose last
# session can be reopened, and aw open starts a fresh one from the handoff. Only the human in the
# owner checkout sees it: not an agent session, not a lane, not --json.
# req: R64
# source: dogfood, RideTracker: "I'm not really sure what to do next here"
# milestone: M12

workspace solo --single --init
stubs codex
session s-1 codex
exec aw attach 'add feature flag'
exec aw lanes
stdout '^01 feature-flag'
! stdout 'Continue a lane'
end-session s-1

exec aw lanes
stdout '^Continue a lane:$'
stdout '^   aw resume <lane>   reopen its last session where it stopped \(feature-flag\)$'
stdout '^   aw open <lane>     start a fresh session that begins with the lane''s latest handoff$'
exec aw lanes --json
! stdout 'Continue'

cd .worktrees/01
exec aw lanes
! stdout 'Continue a lane'
