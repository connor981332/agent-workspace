# aw discard --force removes a lane even with uncommitted work, which is lost; the lane's branches
# are still archived first, so nothing committed goes with it.
# req: R27
# source: issue #143
# milestone: M2

workspace shop --eager --init
exec aw attach 'add feature flag'
lane-commit 01 web/flag.txt 'unmerged work'
exec git -C web rev-parse aw/feature-flag
cp stdout $WORK/head

exec sh -c 'echo wip >> web/.worktrees/01/flag.txt && echo scratch > web/.worktrees/01/scratch.txt'
! exec aw discard feature-flag --yes
stderr 'has uncommitted work in web \(2\), which aw discard would lose; nothing was changed'
stderr 'aw discard --force loses it'
exists web/.worktrees/01/scratch.txt

# The preview says the changes would be lost, and --force alone still needs confirming.
! exec aw discard feature-flag --force
stderr 'confirm with --yes'
stderr '^  web: 1 commit, not pushed, 2 uncommitted \(lost with --force\)$'
exists web/.worktrees/01/scratch.txt

! exec aw discard --orphans --force --yes
stderr '--force is for one lane'

exec aw discard feature-flag --force --yes
stdout 'Discarded lane feature-flag'
stderr 'losing its uncommitted work in web \(2\)'
! exists .worktrees/01 web/.worktrees/01
exec sh -c 'git -C web for-each-ref --format="%(objectname)" refs/aw/archive/feature-flag | cmp - "$WORK/head"'
! exec git -C web rev-parse --verify --quiet refs/heads/aw/feature-flag
exec aw sweep --json
! json stdout .lanes[0]
