# aw version --json gives the same three numbers as JSON, for scripts and agents.
# req: R93
# milestone: M0
# changed: both schema versions are 1 since the configuration and state schemas exist (M1); they were 0 before.

exec aw version --json
json stdout .version
json stdout .config_schema 1
json stdout .state_schema 1
! stderr .

# The text form and the JSON form agree.
exec aw version
stdout '\(config schema 1, state schema 1\)'
