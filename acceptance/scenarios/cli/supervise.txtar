# The optional supervisor recovers dead holders on a timer, writes a user service, and has no more
# authority than the command line.
# req: R42
# source: architecture.md, "No daemon"
# milestone: M12

# macOS writes a launchd agent instead, so this checks Linux.
[!linux] skip

owner-may-change
workspace solo --single --init
exec aw supervise --once
exec aw supervise --install
stdout 'To start it'
exists $XDG_CONFIG_HOME/systemd/user/aw-solo.service
grep 'bin/aw supervise' $XDG_CONFIG_HOME/systemd/user/aw-solo.service
exec aw supervise --uninstall
! exists $XDG_CONFIG_HOME/systemd/user/aw-solo.service
exec aw attach 'one'
cd .worktrees/01
! exec awtest-hook -harness codex bash 'aw supervise --install'
stderr 'only the human'
