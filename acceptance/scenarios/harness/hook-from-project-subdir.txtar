# A hook called from deep inside a lane, through a project link or by the worktree's real path, still knows its lane.
# req: R49 R55 R58
# source: C1 test_real_hook_and_routing
# milestone: M3

workspace shop --init
exec aw attach 'add feature flag'
mkdir .worktrees/01/web/src/deep
cd .worktrees/01/web/src/deep
exec awtest-hook read ../README.md
! exec awtest-hook write $OWNER/README.md
stderr 'is outside lane feature-flag'
cd $OWNER/web/.worktrees/01/src/deep
exec awtest-hook bash 'cat ../x.ts'
! exec awtest-hook bash 'touch ../../../../README.md'
stderr 'is outside lane feature-flag'

# The same read from the owner checkout is the owner's to make.
cd $OWNER
exec awtest-hook read README.md
