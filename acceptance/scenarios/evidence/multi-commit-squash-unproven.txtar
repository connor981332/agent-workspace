# Several commits squashed into one are not proven merged by local evidence: no single patch
# matches. (A forge's exact-head proof can prove them; see evidence/github-states.)
# req: R25
# source: C1 test_lanes.py::test_patch_and_squash_proofs
# milestone: M2

workspace solo --single --init
exec aw attach 'add feature flag'
lane-commit 01 a.txt 'first'
lane-commit 01 b.txt 'second'
git-squash . aw/feature-flag
exec aw sweep --apply --json
json stdout .lanes[0].action keep
stdout 'not proven merged: 2 commits not in'
exists .worktrees/01/a.txt

# A history with merge commits cannot be proven by patches either.
exec git -C .worktrees/01 merge -q --no-ff -m 'merge main' main
exec aw sweep --json
stdout 'its history has merge commits, which patch equivalence cannot prove'
