# GitHub's answer for exactly the lane's head decides: an open or closed pull request keeps the lane,
# a merged one proves it (here a squash merge, which local evidence cannot prove).
# req: R71
# source: C1 test_generic.py::ForgeTests::test_exact_states
# milestone: M2

workspace solo --single --init --forge github
exec aw attach 'add feature flag'
lane-commit 01 a.txt 'first'
lane-commit 01 b.txt 'second'
git-squash . aw/feature-flag
stubs gh
forge-reply gh '^repos/acceptance/solo/pulls\?state=all&head=acceptance%3Aaw%2Ffeature-flag&base=main&per_page=100&page=1$' $WORK/pulls.json

exec sh $WORK/pull.sh open null
exec aw sweep --json
json stdout .lanes[0].action keep
stdout '\(github: change !7 is opened\)'

exec sh $WORK/pull.sh closed null
exec aw sweep --json
stdout '\(github: change !7 is closed\)'

exec sh $WORK/pull.sh closed '"2026-11-08T00:00:00Z"'
exec aw sweep --json
json stdout .lanes[0].action recycle
json stdout .lanes[0].repos[0].proof forge
json stdout .lanes[0].repos[0].forge.iid 7
exec aw sweep --apply --json
json stdout .lanes[0].result done
! exec git rev-parse --verify --quiet refs/heads/aw/feature-flag

-- pull.sh --
# pull.sh <state> <merged_at>: one pull request for the lane's branch at its current head.
head=$(git -C "$OWNER/.worktrees/01" rev-parse HEAD 2>/dev/null || git rev-parse aw/feature-flag)
cat > "$WORK/pulls.json" <<EOS
[{"number": 7, "state": "$1", "merged_at": $2, "html_url": "https://github.com/acceptance/solo/pull/7", "draft": false,
  "head": {"ref": "aw/feature-flag", "sha": "$head", "repo": {"full_name": "acceptance/solo"}},
  "base": {"ref": "main", "repo": {"full_name": "acceptance/solo"}}}]
EOS
