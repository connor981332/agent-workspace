# Applying a sweep again changes nothing: teardown and the drop do not run a second time.
# req: R31 R34
# source: C1 test_cli_apply_callbacks_and_idempotence
# milestone: M5

stubs psql
workspace solo --single --init
exec aw attach 'one'
cd .worktrees/01
exec aw run solo true
cd ../..
exec aw sweep --apply --json
json stdout .lanes[0].result done
exec aw sweep --apply --json
! json stdout .lanes[0]
exec sh -c 'grep -c "^teardown$" $STUB_LOG'
stdout '^1$'
exec sh -c 'grep -c "DROP DATABASE" $STUB_LOG'
stdout '^1$'

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0

[lifecycle]
teardown = 'echo teardown >> "$STUB_LOG"'

[lanes.data.db]
provider = "postgres"
url = "postgres://postgres@localhost:5432"
databases = ["shop"]

[projects.solo]
directory = "."
