# aw sweep --apply says on stderr which lane it is working on and each step, as aw discard does,
# so that a long cleanup is not mistaken for a hang; stdout keeps the report (#125).
# req: R26
# source: issue #125 (0.5.0 dogfood report)
# milestone: M2

workspace solo --single --init
exec aw attach 'one'
exec aw attach 'two'
exec aw sweep --apply --json
json stdout .lanes[0].result done
json stdout .lanes[1].result done
stderr '^aw: 01 one: recycling it$'
stderr '^aw: 01 one: solo: resetting it to its base$'
stderr '^aw: 02 two: removing it$'
! stdout '^aw: '

# A preview does nothing, so it says nothing either.
exec aw sweep
! stderr .

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 1

[projects.solo]
directory = "."
