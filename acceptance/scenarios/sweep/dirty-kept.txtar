# Uncommitted changes keep a lane.
# req: R25
# source: C2 tests::t_lane_rm_protects_unsaved_work
# milestone: M2

workspace shop --init
exec aw attach 'add feature flag'
exec sh -c 'echo edit >> web/.worktrees/01/README.md'
exec aw sweep --apply --json
json stdout .lanes[0].action keep
stdout 'web: 1 changed or untracked \(M README\.md\)'
exists web/.worktrees/01
exec grep edit web/.worktrees/01/README.md
