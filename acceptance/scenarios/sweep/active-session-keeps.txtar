# A lane with an active session attached is kept, even when its work is merged.
# req: R25
# source: C1 test_lanes.py::test_classifier_and_observational_cli
# milestone: M2

workspace solo --single --init
exec aw attach 'add feature flag' --harness claude --session s-1
exec aw sweep --apply --json
json stdout .lanes[0].action keep
json stdout .lanes[0].reason 'session s-1 (claude) is attached'
exists .worktrees/01
