# The secret links aw made, the lane root's project links and its owner pointer do not block
# recycling.
# req: R67
# source: C2 finding F10
# milestone: M2

workspace shop --init
exec sh -c 'printf "SECRET=1\n" > web/.env'
owner-snapshot
exec aw attach 'add feature flag'
exists web/.worktrees/01/.env
exec aw sweep --json
json stdout .lanes[0].action recycle

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[projects.web]
secrets = [".env"]

[projects.api]
