# On a terminal aw gives the container a terminal; piped, only input. Arguments still pass through unchanged.
# req: R47
# source: C1 test_real_pty_selects_interactive_container_flags
# milestone: M6

[!exec:python3] skip 'needs python3 for a pseudo-terminal'
owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec python3 -c 'import pty,sys; pty.spawn(sys.argv[1:])' aw run solo printf 'a b'
grep 'docker exec -it -u dev' $STUB_LOG
exec aw run solo printf 'a b'
stdout '^a b$'
grep 'docker exec -i -u dev' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
