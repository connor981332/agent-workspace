# req: R48 R49
# source: feedback 2026-11-13 (RideTracker 0.2.0 rehearsal)
# milestone: M6
# A lane's own setup does not keep its container from being replaced when the configuration
# changed; another lane's setup protects the container only once it has used it.

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw containers up
grep -count=1 'devcontainer up' $STUB_LOG

# The lane whose install needs the container replaces the outdated one itself.
exec sh -c 'echo "# changed" >> .devcontainer/compose.yaml'
exec aw attach --wait 'one'
! stderr 'is in use'
grep -count=1 'docker rm -f' $STUB_LOG
grep -count=2 'devcontainer up' $STUB_LOG
grep 'aw-keeper sh -c sh .*install.sh' $STUB_LOG

# While lane two is installing in the container, a changed configuration does not replace it.
exec touch $WORK/block
exec aw attach --wait 'two' &
exec sh $WORK/wait-for.sh $WORK/entered
exec sh -c 'echo "# changed again" >> .devcontainer/compose.yaml'
! exec aw run solo true
stderr 'different configuration and is in use: lane 2 is setting up in it'
! exec aw attach --wait 'three'
stderr 'lane 2 is setting up in it'
grep -count=1 'docker rm -f' $STUB_LOG

# Once lane two's setup is done, the container is idle again.
exec rm $WORK/block
wait
exec aw run solo true
grep -count=2 'docker rm -f' $STUB_LOG

-- wait-for.sh --
i=0
while [ ! -e "$1" ]; do
  i=$((i + 1))
  [ "$i" -lt 300 ] || { echo "timed out waiting for $1" >&2; exit 1; }
  sleep 0.1
done
-- install.sh --
# Lane 02's install waits inside the container while $WORK/block exists.
if [ "$AW_LANE" = 02 ] && [ -e "$WORK/block" ]; then
  touch "$WORK/entered"
  while [ -e "$WORK/block" ]; do sleep 0.1; done
fi
-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"
install = "sh $WORK/install.sh"

[projects.solo.servers.app]
command = "exec sleep 60 # {port}"
port = 3000
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
