# Git never goes through the container, because a worktree's .git names host paths.
# req: R47
# source: C2 finding F11
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw attach 'one'
cd .worktrees/01
exec aw run solo true
exec sh -c 'echo x > f.txt'
exec aw sweep
cd ../..
! grep 'docker exec.* git' $STUB_LOG
! grep 'devcontainer.* git' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
