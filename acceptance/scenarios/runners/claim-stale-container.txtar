# A container left over from a moved checkout is removed, and a new one is made here.
# req: R48
# source: C2 test_ws.sh t_init_claims_stale_container_and_starts_infra
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec sh -c 'mkdir -p $STUB_STATE/ps $STUB_STATE/inspect $STUB_STATE/folder $STUB_STATE/state; n=$(basename "$PWD" | tr "[:upper:]" "[:lower:]")_devcontainer; echo old > $STUB_STATE/ps/${n}__app; echo /nowhere/old-checkout > $STUB_STATE/folder/old; echo false > $STUB_STATE/state/old; printf "[{\"Id\":\"old\",\"State\":{\"Running\":false},\"Config\":{\"Labels\":{\"devcontainer.local_folder\":\"/nowhere/old-checkout\"}},\"Mounts\":[]}]" > $STUB_STATE/inspect/old'
exec aw run solo true
stderr 'Removing container old, left over from /nowhere/old-checkout'
grep 'docker rm -f old' $STUB_LOG
grep 'devcontainer up' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
