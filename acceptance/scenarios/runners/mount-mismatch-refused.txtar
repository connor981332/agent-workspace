# A running container that lacks a seat port or the same-path mount is refused, with the fix, and is left running.
# req: R50 R47
# source: C1 test_real_hook_and_routing; C2 finding F3
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw containers up
exec sh -c 'sed "s/\"3200\/tcp\":\[{\"HostPort\":\"3200\"}\]/\"1\/tcp\":[]/" $STUB_STATE/inspect/c-* > $WORK/i && cp $WORK/i $STUB_STATE/inspect/$(ls $STUB_STATE/inspect)'
! exec aw run solo true
stderr 'does not publish port 3200'
stderr 'aw containers recreate solo'
! grep 'docker rm' $STUB_LOG
exec sh -c 'sed "s#\"Destination\":\"[^\"]*\"#\"Destination\":\"/solo\"#; s/\"1\/tcp\":\[\]/\"3200\/tcp\":[{\"HostPort\":\"3200\"}]/" $STUB_STATE/inspect/c-* > $WORK/i && cp $WORK/i $STUB_STATE/inspect/$(ls $STUB_STATE/inspect)'
! exec aw run solo true
stderr 'does not mount .* at the same path'

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
