# A devcontainer.json that does not list the fragment is refused with the fix.
# req: R47
# source: spec S7
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
! exec aw containers up
stderr 'does not list aw.compose.yaml'
stderr 'add it after the project'

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
