# A project local Compose slot gets the same-path mount and seat ports without changing its editor folder or requiring aw in initializeCommand.
# req: R48
# source: C2 test_ws.sh t_ws_starts_missing_container_then_execs
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw doctor
stdout 'devcontainer solo: aw writes its mount and seat ports into compose.local.yaml'
! exists $STUB_LOG
exec aw run solo sh -c 'echo "in=$AW_PROJECT"; pwd -P'
stdout '^in=solo$'
grep 'npx -y @devcontainers/cli@0.89.0 up --workspace-folder' $STUB_LOG
grep 'docker exec -i -u dev -w .* -e AW_PROJECT' $STUB_LOG
exec aw run solo true
grep -count=1 'devcontainer up' $STUB_LOG

exists .devcontainer/compose.local.yaml
! exists .devcontainer/aw.compose.yaml
grep '^name: ' .devcontainer/compose.local.yaml
grep 'source: ' .devcontainer/compose.local.yaml
grep 'target: ' .devcontainer/compose.local.yaml
grep '127.0.0.1:3200:3200' .devcontainer/compose.local.yaml
exec git check-ignore .devcontainer/compose.local.yaml
stdout '.devcontainer/compose.local.yaml'

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"
local_compose = "compose.local.yaml"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "compose.local.yaml"],
  "service": "app",
  "workspaceFolder": "/workspaces/solo",
  "remoteUser": "dev",
  "initializeCommand": "touch .devcontainer/compose.local.yaml",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
