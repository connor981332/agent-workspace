# A container running from another checkout that still exists is refused, and left alone; VS Code gets the same answer from aw containers claim.
# req: R48
# source: C2 test_ws.sh t_init_refuses_live_other_checkout
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
mkdir $WORK/other
cp workspace.toml $WORK/other/file
exec sh -c 'mkdir -p $STUB_STATE/ps $STUB_STATE/inspect $STUB_STATE/folder $STUB_STATE/state; n=$(basename "$PWD" | tr "[:upper:]" "[:lower:]")_devcontainer; echo old > $STUB_STATE/ps/${n}__app; echo $WORK/other > $STUB_STATE/folder/old; echo true > $STUB_STATE/state/old; printf "[{\"Id\":\"old\",\"State\":{\"Running\":true},\"Config\":{\"Labels\":{\"devcontainer.local_folder\":\"$WORK/other\"}},\"Mounts\":[]}]" > $STUB_STATE/inspect/old'
! exec aw containers claim solo
stderr 'running from another checkout'
! exec aw run solo true
stderr 'running from another checkout'
! grep 'docker rm' $STUB_LOG
! grep 'devcontainer up' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
