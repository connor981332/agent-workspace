# The Compose project name in aw's fragment is the name VS Code derives from the folder, and the fragment stays out of Git.
# req: R48
# source: C2 finding F1
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw containers up
exec sh -c 'basename "$PWD"'
cp stdout $WORK/folder
exec sh -c 'grep "^name: $(cat $WORK/folder | tr "[:upper:]" "[:lower:]")_devcontainer$" .devcontainer/aw.compose.yaml'
exec git status --porcelain
! stdout 'aw.compose'
grep 'aw.compose.yaml' .git/info/exclude
exec aw containers up
exec sh -c 'grep -c aw.compose.yaml .git/info/exclude'
stdout '^1$'

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
