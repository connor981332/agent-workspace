# The only way aw starts a container is devcontainer up: never docker run, docker compose up or docker start.
# req: R48
# source: C2 finding F1
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw containers up
stdout 'solo container is running'
grep 'devcontainer up' $STUB_LOG
! grep 'docker run' $STUB_LOG
! grep 'docker start' $STUB_LOG
! grep 'docker compose' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
