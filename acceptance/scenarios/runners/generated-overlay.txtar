# An unwired Compose project gets an ignored aw configuration, and its committed file stays intact.
# req: R47
# source: spec S7
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw doctor
stdout 'devcontainer solo: aw generates .devcontainer/aw/devcontainer.json'
! exists $STUB_LOG
exec aw containers up
exists .devcontainer/aw/devcontainer.json
exists .devcontainer/aw/aw.compose.yaml
! exists .devcontainer/aw.compose.yaml
grep 'name: existing-stack' .devcontainer/aw/aw.compose.yaml
grep '127.0.0.1:3200:3200' .devcontainer/aw/aw.compose.yaml
grep 'up --workspace-folder .* --config .*\.devcontainer/aw/devcontainer.json' $STUB_LOG
exec git diff --exit-code HEAD -- .devcontainer/devcontainer.json
exec git check-ignore .devcontainer/aw/devcontainer.json .devcontainer/aw/aw.compose.yaml
stdout '.devcontainer/aw/devcontainer.json'
stdout '.devcontainer/aw/aw.compose.yaml'
# The generated choice is restored even when the matching container is already running.
exec sh -c 'rm .devcontainer/aw/devcontainer.json .devcontainer/aw/aw.compose.yaml'
exec aw run solo true
exists .devcontainer/aw/devcontainer.json
exists .devcontainer/aw/aw.compose.yaml
grep -count=1 'devcontainer up' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "echo original initialization",
}
-- .devcontainer/compose.yaml --
name: existing-stack
services:
  app:
    image: stub
