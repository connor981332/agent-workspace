# Recreating or removing a container is refused while a lane holds a seat, or anything is attached; afterwards it goes through devcontainer up again.
# req: R49
# source: spec owner decision 2026-11-08
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw serve stack --json
! exec aw containers recreate solo
stderr 'in use'
stderr 'holds a seat on stack'
! grep 'compose -p' $STUB_LOG
exec aw stop stack
exec sh -c 'mkdir -p $STUB_STATE/top; echo "200 50 node .vscode-server/server.js" > $STUB_STATE/top/$(ls $STUB_STATE/inspect)'
! exec aw containers down solo
stderr 'attached: node .vscode-server'
! grep 'compose -p' $STUB_LOG
exec sh -c 'rm $STUB_STATE/top/*'
exec aw containers recreate solo
stdout 'solo container is running'
grep -count=2 'devcontainer up' $STUB_LOG
exec aw containers down solo
stdout 'stopped and removed'

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
