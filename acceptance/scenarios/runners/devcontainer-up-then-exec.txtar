# A command in a project whose container is not running starts it with the pinned CLI, then runs in it; the next command does not start it again.
# req: R48
# source: C2 test_ws.sh t_ws_starts_missing_container_then_execs
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw run solo sh -c 'echo "in=$AW_PROJECT"; pwd -P'
stdout '^in=solo$'
grep 'npx -y @devcontainers/cli@0.89.0 up --workspace-folder' $STUB_LOG
grep 'docker exec -i -u dev -w .* -e AW_PROJECT' $STUB_LOG
exec aw run solo true
grep -count=1 'devcontainer up' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
