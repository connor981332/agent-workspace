# A lane's command runs in the one container, in the lane's worktree, with the lane's environment, whose values never appear in an argument list.
# req: R47 R74
# source: C2 test_ws.sh t_ws_lane_uses_worktree_env_and_port
# milestone: M6

owner-may-change
stubs docker devcontainer npx
workspace solo --single --init
exec sh -c 'cp -R $WORK/.devcontainer . && git add .devcontainer && git -c user.name=t -c user.email=t@t commit -q -m devcontainer && git push -q origin HEAD:main'
exec aw attach 'one'
cd .worktrees/01
exec aw run solo sh -c 'pwd -P; echo "$AW_LANE $AW_LANE_NAME"'
stdout '/\.worktrees/01$'
stdout '^01 one$'
grep -count=1 'devcontainer up' $STUB_LOG
grep ' -e AW_LANE ' $STUB_LOG
! grep 'AW_LANE=01' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.solo]
directory = "."
runner = "devcontainer"

[projects.solo.servers.app]
command = "echo $$ > $WORK/server.pid; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 2
servers = ["solo.app"]
-- .devcontainer/devcontainer.json --
{
  // the team's file
  "dockerComposeFile": ["compose.yaml", "aw.compose.yaml"],
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "dev",
  "initializeCommand": "bin/aw containers claim solo",
}
-- .devcontainer/compose.yaml --
services:
  app:
    image: stub
