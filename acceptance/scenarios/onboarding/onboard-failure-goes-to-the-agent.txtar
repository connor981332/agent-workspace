# When a lane cannot be created, aw onboard --lane starts the agent anyway, in the owner checkout as a pair
# session, with the failure in front of it.
# req: R85
# source: dogfood of 0.1.0-rc.2
# milestone: M12

owner-may-change
stubs claude
workspace shop --eager --init
exec git -C web checkout -q --detach
! exec aw doctor --json
stdout 'detached HEAD'
exec aw onboard --lane --harness claude
stderr 'no lane could be created'
# Before offering an hour's maintenance (on a terminal), it says what failed (plans/dogfood-0.3.md 2.7).
stderr '^Setup did not finish: aw doctor found problems\.$'
stderr '^No lane could be created: .*detached HEAD'
grep 'Something failed before you started' $STUB_LOG
grep 'detached HEAD' $STUB_LOG
grep 'pair session' $STUB_LOG
! exists .worktrees/01
grep 'claude:pair-' $STUB_LOG
