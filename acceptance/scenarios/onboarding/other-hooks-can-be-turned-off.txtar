# A workspace migrating from another system has hooks that can refuse everything in an aw lane.
# aw reports them before it starts, and can leave them out of the onboarding lane only.
# req: R85
# source: onboarding RideTracker, which had its own lane guard
# milestone: M12

stubs claude
workspace solo --single --init
owner-may-change
exec sh $WORK/old.sh
exec aw setup --harness claude
exec aw inspect
stdout 'not aw''s.*old-hook'

# By default they stay, and the human and the agent are told.
exec aw onboard --harness claude
stderr 'hooks that are not aw''s'
grep 'old-hook' .worktrees/01/.claude/settings.json
grep 'they run in this lane too' $STUB_LOG
exec aw discard 01 --yes

exec aw onboard --harness claude --without-other-hooks
! grep 'old-hook' .worktrees/01/.claude/settings.json
grep 'hook claude pre-tool-use' .worktrees/01/.claude/settings.json
grep 'turned them off in this lane only' $STUB_LOG
grep 'old-hook' .claude/settings.json

# Leaving them out does not count as the lane's work.
exec aw discard 01 --yes
! exists .worktrees/01
grep 'old-hook' .claude/settings.json

-- old.sh --
mkdir -p .claude
cat > .claude/settings.json <<EOS
{"hooks":{"PreToolUse":[{"hooks":[{"type":"command","command":"old-hook pre-tool-use"}]}]}}
EOS
git add -A
git commit -qm 'old framework'
