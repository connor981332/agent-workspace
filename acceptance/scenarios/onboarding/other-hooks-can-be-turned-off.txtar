# A workspace migrating from another system has hooks that can refuse everything in an aw lane. The
# onboarding lane keeps them unless asked, says which, and always leaves the human's checkout alone.
# req: R85
# source: onboarding RideTracker, which had its own lane guard
# milestone: M12

stubs claude
workspace solo --single --init
owner-may-change
exec sh $WORK/old.sh
exec aw setup --harness claude
exec aw inspect
stdout 'not aw''s.*old-hook'

# On by default: onboarding does not change how the workspace's agents behave.
exec aw onboard --harness claude
stderr 'not aw''s and they run in the lane too'
stderr 'old-hook'
grep 'old-hook' .worktrees/01/.claude/settings.json
grep 'they run in this lane too' $STUB_LOG
exec aw discard 01 --yes
! exists .worktrees/01

# Off when asked, in that lane only.
exec aw onboard --harness claude --without-other-hooks
stderr 'turning off hooks that are not aw''s'
! grep 'old-hook' .worktrees/01/.claude/settings.json
grep 'hook claude pre-tool-use' .worktrees/01/.claude/settings.json
grep 'aw turned them off in this lane only' $STUB_LOG
grep 'old-hook' .claude/settings.json
exec aw discard 01 --yes

# Off too when both sets of hooks are already committed, so nothing else is copied into the lane.
exec git add -A
exec git commit -qm 'aw and the old hooks'
exec aw onboard --harness claude --review --without-other-hooks
! grep 'old-hook' .worktrees/01/.claude/settings.json
grep 'hook claude pre-tool-use' .worktrees/01/.claude/settings.json
exec aw discard 01 --yes
! exists .worktrees/01
exec git status --porcelain
! stdout .

# An ordinary lane is not onboarding, and keeps them.
exec aw attach 'plain work'
grep 'old-hook' .worktrees/01/.claude/settings.json

-- old.sh --
mkdir -p .claude
cat > .claude/settings.json <<EOS
{"hooks":{"PreToolUse":[{"hooks":[{"type":"command","command":"old-hook pre-tool-use"}]}]}}
EOS
git add -A
git commit -qm 'old framework'
