# aw inspect lists Git repositories in the workspace root that are not projects yet, with the
# command that adds one, so a repository cloned there is not missed.
# req: R85
# source: plans/agent-feedback.md, item 6
# milestone: M12

owner-may-change
workspace shop --init
exec git init -q payments
mkdir notes
exec aw inspect
stdout '^payments: a Git repository that is not a project yet → aw add project payments$'
! stdout 'notes'
! stdout '^web: a Git'
exec aw inspect --json
json stdout .unconfigured[0] payments
