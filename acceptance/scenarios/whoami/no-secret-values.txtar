# aw whoami never prints a secret value, from the environment, an env file or the configuration.
# req: R68 R93
# source: C1 test_tooling.py::test_identity_is_observational_and_handles_unknown_slot; C2 finding F21
# milestone: M1

workspace shop
exec aw init
exec sh -c 'printf "DATABASE_PASSWORD=hunter2-db\n" > .env'
owner-snapshot

env API_TOKEN=s3cr3t-token-value
env AW_SESSION=session-1
exec aw whoami
stdout '^session    session-1$'
! stdout 'hunter2|s3cr3t'
! stderr 'hunter2|s3cr3t'
exec aw whoami --json
! stdout 'hunter2|s3cr3t'
json stdout .session session-1
