# aw whoami warns when the processes behind a seat have gone, and leaves the lease for a command that changes state.
# req: R68 R93
# source: C1 test_identity_is_observational_and_handles_unknown_slot
# milestone: M4

workspace shop --init
exec aw attach one
cd .worktrees/01
exec aw serve stack
exec sh -c 'for pid in $(cat "$WORK/pids"); do kill -9 "$pid"; done; sleep 0.1'
exec aw whoami --json
stdout 'processes behind this lane.s seat on stack have gone'
exec aw queue --json
json stdout .resources[0].holders[0].lane_name one

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0

[projects.web]
directory = "web"

[projects.api]
directory = "api"

[projects.web.servers.app]
command = "echo $$ >> $WORK/pids; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 1
servers = ["web.app"]
