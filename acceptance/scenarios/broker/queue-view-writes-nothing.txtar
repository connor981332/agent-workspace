# aw queue only reads, even with a holder that has died, and works before any state exists.
# req: R2 R42
# source: C1 test_rt_slots_never_reaps
# milestone: M4

workspace shop --init
exec aw queue --json
json stdout .resources[0].resource stack
exec aw attach one
cd .worktrees/01
exec aw serve stack
exec sh $WORK/kill-and-sum.sh
cp stdout $WORK/before
exec aw queue
stdout 'seat 1  one'
exec sh $WORK/sum.sh
cmp stdout $WORK/before

-- kill-and-sum.sh --
for pid in $(cat "$WORK/pids"); do kill -9 "$pid"; done
sleep 0.1
sh "$WORK/sum.sh"
-- sum.sh --
cat "$OWNER/.git/aw/state.db" "$OWNER/.git/aw/state.db-wal" 2>/dev/null | cksum
-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.web]
directory = "web"

[projects.web.servers.app]
command = "echo $$ >> $WORK/pids; exec sleep 60 # {port}"
port = 3000

[projects.web.servers.db]
command = "echo $$ >> $WORK/pids; exec sleep 61 # {port}"
port = 5000

[projects.api]
directory = "api"

[resources.stack]
kind = "process"
capacity = 1
servers = ["web.app", "web.db"]
owner_counts = true
owner_preempts = true
evict_grace = "2s"

