# The owner cuts in. The lane holding the seat longest gets SIGTERM to its process group, is told on
# its next tool call, keeps its files, and goes back to the head of the queue.
# req: R39 R40 R43 R61
# source: C1 test_owner_eviction_waits_for_busy_then_notifies_and_prioritizes
# milestone: M4
# changed: the evicted lane gets SIGTERM, then SIGKILL after evict_grace, instead of the owner waiting for a busy lane.

workspace shop --init
exec aw attach one
exec aw attach two
cd .worktrees/01
exec sh -c 'echo kept > note.txt'
exec aw serve stack
exec aw queue --json
cp stdout $WORK/before
cd ../02
! exec aw serve stack
stderr 'position 1'

cd $OWNER
exec aw serve stack
stderr 'stopping stack, held by lane one'
stdout 'Holding seat 0 on stack'
stdout 'app http://localhost:3000'

cd .worktrees/01
exists note.txt
exec awtest-hook bash 'ls'
stdout 'given to the owner'
stdout 'first in line'
cd ../..
exec aw queue --json
json stdout .resources[0].holders[0].lane 0
json stdout .resources[0].waiting[0].lane_name one
json stdout .resources[0].waiting[1].lane_name two

# When the owner stops, the seat goes to the lane that was evicted, not the one behind it.
exec aw stop stack
exec aw queue --json
json stdout .resources[0].holders[0].lane_name one
json stdout .resources[0].holders[0].state reserved
cd .worktrees/01
exec aw serve stack
stdout 'Holding seat 1'
exec aw stop stack

# An agent in the owner checkout does not get the owner's seat.
cd $OWNER
env CLAUDE_CODE_SESSION_ID=abc
! exec aw serve stack
stderr 'agent session with no lane'
env CLAUDE_CODE_SESSION_ID=

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.web]
directory = "web"

[projects.web.servers.app]
command = "echo $$ >> $WORK/pids; exec sleep 60 # {port}"
port = 3000

[projects.web.servers.db]
command = "echo $$ >> $WORK/pids; exec sleep 61 # {port}"
port = 5000

[projects.api]
directory = "api"

[resources.stack]
kind = "process"
capacity = 1
servers = ["web.app", "web.db"]
owner_counts = true
owner_preempts = true
evict_grace = "2s"

