# A holder over its maximum hold while others wait is warned, then sent to the tail of the queue. With nobody waiting it keeps the seat.
# req: R41 R43
# source: spec (no candidate source)
# milestone: M4

workspace shop --init
exec aw attach one
exec aw attach two
exec aw attach three
cd .worktrees/01
exec aw serve stack
exec sh -c 'sleep 1.3'
exec aw attach four
cd ../01
exec aw queue --json
json stdout .resources[0].holders[0].lane_name one
cd ../02
! exec aw serve stack
cd ../03
! exec aw serve stack
cd ../01
exec awtest-hook bash 'ls'
stdout 'will be taken'
exec sh -c 'sleep 1.3'
exec aw attach five
exec aw queue --json
json stdout .resources[0].holders[0].lane_name two
json stdout .resources[0].waiting[0].lane_name three
json stdout .resources[0].waiting[1].lane_name one
exec awtest-hook bash 'ls'
stdout 'at the end'

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0

[projects.web]
directory = "web"

[projects.api]
directory = "api"

[projects.web.servers.app]
command = "echo $$ >> $WORK/pids; exec sleep 60 # {port}"
port = 3000

[resources.stack]
kind = "process"
capacity = 1
servers = ["web.app"]
evict_grace = "1s"
max_hold = "1s"
