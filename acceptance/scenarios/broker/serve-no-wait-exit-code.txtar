# A request that joins the queue exits with its own status, so a script can tell it from a failure,
# and a lane holds only one place in line.
# req: R37 R93
# source: C1 test_setup_failure_no_wait_and_server_refusal
# milestone: M4

workspace shop --init
exec aw attach one
exec aw attach two
cd .worktrees/01
exec aw serve stack
cd ../02
exec sh -c 'aw serve stack 2>/dev/null; echo "status=$?"'
stdout 'status=3'
exec sh -c 'aw serve stack --json 2>/dev/null; echo "status=$?"'
stdout '"position": 1'
stdout 'status=3'
exec aw queue --json
json stdout .resources[0].waiting[0].lane_name two
! exec aw serve nothere
stderr 'no resource named "nothere"'
cd ../01
exec aw stop stack

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0
port_stride = 100

[projects.web]
directory = "web"

[projects.web.servers.app]
command = "echo $$ >> $WORK/pids; exec sleep 60 # {port}"
port = 3000

[projects.web.servers.db]
command = "echo $$ >> $WORK/pids; exec sleep 61 # {port}"
port = 5000

[projects.api]
directory = "api"

[resources.stack]
kind = "process"
capacity = 1
servers = ["web.app", "web.db"]
owner_counts = true
owner_preempts = true
evict_grace = "2s"

