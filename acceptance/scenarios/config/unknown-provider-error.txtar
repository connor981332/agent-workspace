# A data block with an unknown provider, or with no url, is refused when the configuration loads, and
# the error says what to write.
# req: R33 R93
# source: C2 t_lane_setup_hook_and_custom_resource
# milestone: M5

workspace solo --single --init
exec sh -c 'printf "\n[lanes.data.db]\nprovider = \"mysql\"\n" >> workspace.toml'
! exec aw config validate
stdout 'must be one of'
exec git checkout workspace.toml
exec sh -c 'printf "\n[lanes.data.db]\nprovider = \"postgres\"\ndatabases = [\"shop\"]\n" >> workspace.toml'
! exec aw config validate
stdout 'is a postgres provider with no url'
stdout 'postgres://postgres@localhost:5432'
exec git checkout workspace.toml

owner-may-change

-- workspace.toml --
[workspace]
name = "Solo"
namespace = "solo"
schema = 1

[projects.solo]
directory = "."
