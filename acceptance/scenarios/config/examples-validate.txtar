# Every example workspace.toml in the repository validates.
# req: R9
# source: C2 tests::t_example_workspace_loads
# milestone: M1

exec sh -c 'ls "$AW_REPO"/examples/*/workspace.toml | wc -l'
! stdout '^ *0$'
exec sh -c 'aw config validate "$AW_REPO"/examples/*/workspace.toml'
! stdout 'invalid|→'
stdout 'shop/workspace.toml: valid'
