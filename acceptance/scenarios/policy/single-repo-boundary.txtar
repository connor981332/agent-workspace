# In a workspace that is a single repository, the lane root is the lane's worktree, and the same
# boundary holds.
# req: R55 R58
# source: C1 HostLaneTests.test_guards_on_a_single_repo_lane
# milestone: M3

workspace solo --single --init
exec aw attach 'add feature flag'
cd .worktrees/01
exec awtest-hook bash 'cat README.md && echo x > new.txt'
exec awtest-hook write src/new.go
! exec awtest-hook bash 'cat ../../README.md'
stderr 'is outside lane feature-flag'
! exec awtest-hook write $OWNER/README.md
! exec awtest-hook bash 'git -C ../.. status'
