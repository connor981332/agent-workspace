# Owner-only commands are found wherever the shell would run them: substitutions, pipes, wrappers, nested shells. Merely mentioning one is not running it.
# req: R64
# source: C1 test_delegation_lets_owner_checkout_run_only_in_scope_maintenance
# milestone: M3

workspace shop --init
exec aw attach 'add feature flag'
cd .worktrees/01
! exec awtest-hook -harness codex bash 'x=$(bin/aw discard y --yes)'
stderr 'inside a substitution'
! exec awtest-hook -harness codex bash 'echo `bin/aw delegate --for 1h`'
! exec awtest-hook -harness codex bash 'true && bin/aw upgrade'
! exec awtest-hook -harness codex bash 'true | bin/aw pair'
! exec awtest-hook -harness codex bash 'env A=1 nohup bin/aw setup'
! exec awtest-hook -harness codex bash 'sh -c "bin/aw park x"'
! exec awtest-hook -harness codex bash 'eval bin/aw unpark x'
exec awtest-hook bash 'echo "then run bin/aw discard x; done"'
exec awtest-hook bash 'grep "bin/aw discard" README.md'
