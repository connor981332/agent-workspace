# Agents do not read or print secrets: the secret files and the lane's links to them, the
# environment, and a process's environ. Tools that need them read them directly.
# req: R68
# source: C2 F21 Agents must not read secrets
# milestone: M3

workspace shop --init
exec sh -c 'printf "SECRET=1\n" > web/.env'
owner-snapshot
exec aw attach 'add feature flag'
cd .worktrees/01
! exec awtest-hook bash 'cat web/.env'
stderr 'reads web/.env, which holds secrets'
! exec awtest-hook read web/.env
stderr 'is a secret file'
! exec awtest-hook bash 'grep SECRET < web/.env'
! exec awtest-hook bash 'env'
stderr 'prints the environment'
! exec awtest-hook bash 'printenv'
! exec awtest-hook bash 'cat /proc/self/environ'
! exec awtest-hook bash 'export -p'
exec awtest-hook bash 'env RAILS_ENV=test bin/aw run web npm test'
exec awtest-hook bash 'echo "$PATH"'

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[projects.web]
secrets = [".env"]

[projects.api]
