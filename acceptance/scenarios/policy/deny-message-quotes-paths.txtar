# A refusal quotes the paths it names, so the fix it suggests can be pasted into a shell even when
# a path has spaces or quotes; it never repeats the refused command back.
# req: R55
# source: C1 test_recovery_guidance_quotes_paths_and_never_replays_shell
# milestone: M3

workspace shop --init
exec aw attach 'add feature flag'
cd .worktrees/01
! exec awtest-hook bash 'touch ../../new.txt; rm -rf ~'
stderr 'aw: ../../new.txt is outside lane feature-flag \(it resolves to ''.*/it''\\''''s a workspace/shop/new.txt'''
stderr 'work inside the lane, under ''.*/it''\\''''s a workspace/shop/.worktrees/01'''
! stderr 'rm -rf'
