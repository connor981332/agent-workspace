# A lane agent is confined to its lane, through the real hook: file tools and literal paths in shell
# commands that would change the owner checkout, another lane or another lane's state are refused,
# and paths outside the workspace are not the boundary's concern. Reading anywhere is allowed, and
# a read of the owner's copy of a file the lane has too comes with a note naming the lane's copy.
# req: R55 R58
# source: C1 test_boundary
# milestone: M3
# changed: in this layout a lane's projects are links to their worktrees, so a file argument such as
# ../AGENTS.md from inside a project resolves physically, into the owner checkout, and is refused;
# cd .. still returns to the lane root.
# changed: reads outside the lane are allowed (plans/agent-feedback.md, items 1 and 2), where C1
# refused them.

workspace shop --init
exec aw attach 'first thing'
exec aw attach 'second thing'
exec sh -c 'ln -s "$OWNER" .worktrees/01/escape'
cd .worktrees/01

exec awtest-hook bash 'cat AGENTS.md web/README.md'
exec awtest-hook bash 'cd web && cat README.md && cd .. && cat AGENTS.md'
exec awtest-hook bash 'cat /tmp/scratch/out.txt ~/.claude/notes.md'
exec awtest-hook bash 'echo $(pwd)/x 2>/dev/null'
exec awtest-hook bash 'bin/aw run web npm test -- test/unit/example.ts'

! exec awtest-hook bash 'touch ../../README.md'
stderr 'aw: ../../README.md is outside lane first-thing'
stderr '→ change this lane''s copy'
! exec awtest-hook bash 'echo x > ../../new.txt'
stderr '→ work inside the lane'
! exec awtest-hook bash 'touch escape/AGENTS.md'
stderr 'is outside lane first-thing'
! exec awtest-hook bash 'touch ../02/AGENTS.md'
! exec awtest-hook bash 'cd web && rm ../AGENTS.md'
! exec awtest-hook bash 'touch ../../.git/aw/lanes/02/server.log'
exec awtest-hook bash 'touch ../../.git/aw/lanes/01/server.log'
! exec awtest-hook bash 'rm "$(git rev-parse --show-toplevel)/AGENTS.md"'
stderr 'aw cannot determine'
! exec awtest-hook bash 'cd "$X" && rm -rf build'
stderr 'aw cannot determine'
! exec awtest-hook bash 'cd "$(mktemp -d)"; rm -rf build'

# Reads: the owner checkout, another lane, through a variable or a loop.
exec awtest-hook bash 'cat ../../README.md'
stdout 'is the owner checkout''s copy'
stdout 'this lane''s is'
exec awtest-hook bash 'cat ../02/AGENTS.md && git -C ../.. status'
exec awtest-hook bash 'O=../..; grep -n x "$O/AGENTS.md" AGENTS.md'
exec awtest-hook bash 'for p in web api; do git -C "$p" status; done'
exec awtest-hook bash 'cat "$(git rev-parse --show-toplevel)/AGENTS.md"'

# File tools.
exec awtest-hook read web/README.md
exec awtest-hook read ../../README.md
stdout 'this lane''s is'
! exec awtest-hook write $OWNER/web/README.md
exec awtest-hook write /tmp/tool-output.txt

# Every refusal exits 2, which the harness reads as a deny.
exec sh -c 'awtest-hook bash "touch ../../AGENTS.md"; echo "status=$?"'
stdout '^status=2$'
