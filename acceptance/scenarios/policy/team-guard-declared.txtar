# A team's declared guards apply to every harness and every role: command patterns over the parsed
# command, and file patterns, in a lane's copy too.
# req: R54
# source: spec (no candidate source)
# milestone: M3

workspace shop --init
exec aw config explain guards.no-apply.action
exec aw attach 'add feature flag'
cd .worktrees/01

! exec awtest-hook bash 'terraform apply -auto-approve'
stderr 'Deploys go through CI \(team guard no-apply\)'
! exec awtest-hook bash 'echo hi; terraform -chdir=infra apply'
stderr 'team guard no-apply'
! exec awtest-hook bash 'echo $(terraform apply)'
stderr 'team guard no-apply'
! exec awtest-hook bash 'terraform "$WHAT"'
stderr 'team guard no-apply'
exec awtest-hook bash 'terraform plan'
! stdout .
! exec awtest-hook -harness codex bash 'terraform apply'
! exec awtest-hook -harness grok bash 'terraform apply'
! exec awtest-hook -harness opencode bash 'terraform apply'

# File patterns, through the file tools and the shell, and through a project's lane link.
! exec awtest-hook write web/db/schema.rb
stderr 'team guard schema'
! exec awtest-hook bash 'echo x > web/db/schema.rb'
stderr 'team guard schema'
! exec awtest-hook edit web/config/a/b/secrets.yml
stderr 'team guard schema'
exec awtest-hook write web/db/other.rb
! stdout .
exec awtest-hook read web/db/schema.rb
! stdout .

# An "ask" guard asks a harness that can, and refuses for one that cannot.
exec awtest-hook bash 'kubectl delete pod x'
stdout '"permissionDecision":"ask"'
stdout 'Check the cluster first'
! exec awtest-hook -harness codex bash 'kubectl delete pod x'

# A malformed guard is a configuration error, so nothing is decided on it.
cd $OWNER
cp workspace.toml $WORK/good
exec sh -c 'printf "\n[guards.broken]\naction = \"deny\"\n" >> workspace.toml'
! exec aw config validate
stdout 'guards.broken.*has no commands or paths'
cp $WORK/good workspace.toml

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[projects.web]
directory = "web"

[projects.api]
directory = "api"

[guards.no-apply]
commands = ["terraform apply"]
message = "Deploys go through CI"

[guards.schema]
paths = ["web/db/schema.rb", "web/config/**/*.yml"]
message = "Generated by migrations"

[guards.cluster]
commands = ["kubectl delete *"]
action = "ask"
message = "Check the cluster first"
