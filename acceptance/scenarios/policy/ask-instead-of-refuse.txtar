# A hook cannot see what the human told the agent, so where a person can answer it asks rather than
# refuses, force pushes and deleting branches included (the guard tier). A new workspace lets lanes
# publish their own work, while a pre-approved merge can only be the lane's own.
# req: R60 R72
# source: dogfooding RideTracker: agents kept being refused work the human had asked for
# milestone: M12

workspace shop --init
owner-may-change
safeguards
exec sh -c 'printf "\n[publication]\nallow = [\"push\", \"open-merge-request\", \"merge\"]\n" >> workspace.toml'
exec aw attach 'add feature flag'

# In a lane, destructive Git and the human's commands reach the human.
cd .worktrees/01
exec awtest-hook bash 'git reset --hard'
stdout '"permissionDecision":"ask"'
exec awtest-hook bash 'aw discard other --yes'
stdout '"permissionDecision":"ask"'
stdout 'only the human does'

# What cannot be taken back reaches the human too (the guard tier). With pushes pre-approved, a
# force push is not this lane's own push, and is refused with the command that is. A harness that
# cannot ask refuses, and says so.
! exec awtest-hook bash 'git push --force origin aw/feature-flag'
stderr 'only this lane''s own branch is pre-approved'
exec awtest-hook bash 'git branch -D main'
stdout '"permissionDecision":"ask"'
stdout 'deletes a branch'
! exec awtest-hook -harness codex bash 'git reset --hard'
stderr 'discards uncommitted work'
stderr 'this harness cannot ask the human'

# The owner checkout is the human's: destructive Git there goes to the human as well.
cd ../..
exec awtest-hook -session owner-1 bash 'git reset --hard'
stdout '"permissionDecision":"ask"'
stdout 'in the owner checkout, which is the human''s'

# A lane's own work is pre-approved.
cd .worktrees/01
exec awtest-hook bash 'git push origin aw/feature-flag'
! stdout .
exec awtest-hook bash 'glab mr create --fill --yes'
! stdout .
exec awtest-hook bash 'glab mr merge --yes'
! stdout .
exec awtest-hook bash 'gh pr comment --body done'
! stdout .

# What the agent can correct itself is refused with the command that works, and never asks the human.
! exec awtest-hook bash 'glab mr merge 118 --yes'
stderr 'with no number'
! exec awtest-hook bash 'gh --repo a/b pr merge'
stderr 'with no number'
! exec awtest-hook bash 'git push origin main'
stderr 'git push -u origin HEAD'
exec awtest-hook bash 'git push -u origin HEAD'
! stdout .

# Without pre-authorization there is nothing to correct, so the human decides.
exec sh -c 'mkdir -p $XDG_CONFIG_HOME/agent-workspace; printf "[publication]\nallow = []\n" > $XDG_CONFIG_HOME/agent-workspace/shop.toml'
exec awtest-hook bash 'glab mr merge 118 --yes'
stdout '"permissionDecision":"ask"'
