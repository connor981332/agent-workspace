# A lane's secret files are read-only links to the owner's: writing through one, with a file tool
# or a shell redirect, is refused, so a lane cannot change the owner's secrets.
# req: R67
# source: C2 F10 Secrets identical across lanes
# milestone: M3

workspace shop --init
exec sh -c 'printf "SECRET=1\n" > web/.env'
owner-snapshot
exec aw attach 'add feature flag'
cd .worktrees/01
! exec awtest-hook write web/.env
stderr 'linked read-only into the lane'
! exec awtest-hook edit web/.env
! exec awtest-hook bash 'echo SECRET=2 >> web/.env'
! exec awtest-hook bash 'sed -i s/1/2/ web/.env'
exec cat $OWNER/web/.env
stdout 'SECRET=1'

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[projects.web]
secrets = [".env"]

[projects.api]
