# A cached binary that cannot run makes a hook call deny (exit 2, fail closed), with the fix.
# req: R55
# source: C1 test_generic.py::LauncherTests::test_broken_tool_blocks_with_exit_2; C1 test_tooling.py::test_inactive_hook_wrapper_end_to_end_and_broken_import_exits_2
# milestone: M1

workspace shop
exec aw init
owner-snapshot
exec bin/aw version

# Damage the cached binary, keeping it executable.
exec sh -c 'printf "garbage\n" > "$XDG_CACHE_HOME/agent-workspace/bin/$AW_VERSION/aw"'
exec sh -c 'bin/aw hook claude pre-tool-use </dev/null; echo "status=$?"'
stdout '^status=2$'
stderr 'so this call is refused → run bin/aw doctor'

# The same through the Git hook entry point.
exec sh -c 'bin/aw git-hook reference-transaction prepared </dev/null; echo "status=$?"'
stdout '^status=2$'

# A binary that crashes is a refusal too.
exec sh -c 'printf "#!/bin/sh\nexit 70\n" > "$XDG_CACHE_HOME/agent-workspace/bin/$AW_VERSION/aw"'
exec sh -c 'bin/aw hook claude pre-tool-use </dev/null; echo "status=$?"'
stdout '^status=2$'
stderr 'exited with status 70, so this call is refused'
