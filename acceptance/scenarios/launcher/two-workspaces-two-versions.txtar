# Two workspaces on one machine run different pinned versions side by side.
# req: R16
# source: C2 finding F6
# milestone: M1

workspace shop
exec aw init
owner-snapshot

# A second workspace, pinned to another release, with its own mirror.
exec git init -q $WORK/other
cd $WORK/other
exec aw init
exec sh $WORK/pin-fake.sh
cd $OWNER

exec aw version
stdout '^aw '$AW_VERSION' '
cd $WORK/other
env AW_MIRROR=$WORK/mirror2
exec aw version
stdout '^fake aw 9\.9\.9$'
cd $OWNER
exec aw version
stdout '^aw '$AW_VERSION' '

exists $XDG_CACHE_HOME/agent-workspace/bin/$AW_VERSION/aw
exists $XDG_CACHE_HOME/agent-workspace/bin/9.9.9/aw

-- pin-fake.sh --
# Publish a fake aw 9.9.9 for this platform in $WORK/mirror2, and pin the current workspace to it.
set -e
case $(uname -s) in Linux) os=linux ;; Darwin) os=darwin ;; esac
case $(uname -m) in x86_64|amd64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; esac
mkdir -p "$WORK/mirror2"
asset=aw_9.9.9_${os}_${arch}
printf '#!/bin/sh\necho "fake aw 9.9.9"\n' > "$WORK/mirror2/$asset"
if command -v sha256sum >/dev/null; then sum=$(sha256sum "$WORK/mirror2/$asset"); else sum=$(shasum -a 256 "$WORK/mirror2/$asset"); fi
echo "${sum%% *}  $asset" > .aw/lock
echo 9.9.9 > .aw/version
