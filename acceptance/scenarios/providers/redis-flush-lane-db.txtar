# Each lane gets the Redis database with its number, flushed when it is created and when it is dropped.
# Lanes never use database 0, which is the owner's.
# req: R33 R34
# source: C2 t_lane_rm_force_and_drop_data
# milestone: M5

stubs redis-cli
workspace solo --single --init
exec aw attach 'one'
cd .worktrees/01
exec aw run solo sh -c 'echo "$AW_CACHE_URL"'
stdout '^redis://localhost:6390/1$'
cd ../..
grep 'redis-cli -h localhost -p 6390 -n 1 FLUSHDB' $STUB_LOG
exec aw discard one --yes
exec sh -c 'grep -c "n 1 FLUSHDB" $STUB_LOG'
stdout '^2$'
! grep 'n 0 FLUSHDB' $STUB_LOG

-- workspace.toml --
[workspace]
name = "Shop"
namespace = "shop"
schema = 1

[lanes]
pool = 0

[lanes.data.cache]
provider = "redis"
url = "redis://localhost:6390"

[projects.solo]
directory = "."
