#!/bin/sh
# Ported from workspace-candidate-2/tests/stubs/docker.
# Test double for docker. Logs every call to $STUB_LOG and answers from files
# under $STUB_STATE:
#   ps/<compose-project>__<service>   ids `docker ps` returns for those labels
#   running/<compose-project>         services running in a project (one per line)
#   mount/<id>                        source path of the container's workspace mount
#   state/<id>                        true|false, the container's running state
#   net/<name>                        exists when the network exists
#   psql-select                       output for any psql SELECT
set -eu
echo "docker $*" >> "$STUB_LOG"
cmd="$1"; shift
case "$cmd" in
ps)
  project="" service="" running=""
  for a in "$@"; do
    case "$a" in
      label=com.docker.compose.project=*) project="${a#label=com.docker.compose.project=}" ;;
      label=com.docker.compose.service=*) service="${a#label=com.docker.compose.service=}" ;;
      status=running) running=1 ;;
    esac
  done
  if [ -n "$service" ]; then
    cat "$STUB_STATE/ps/${project}__$service" 2>/dev/null || true
  elif [ -n "$running" ]; then
    cat "$STUB_STATE/running/$project" 2>/dev/null || true
  fi
  ;;
inspect)
  id="$1"
  case "$*" in
    *Mounts*) cat "$STUB_STATE/mount/$id" ;;
    *State.Running*) cat "$STUB_STATE/state/$id" ;;
  esac
  ;;
network)
  case "$1" in
    inspect) [ -e "$STUB_STATE/net/$2" ] ;;
    create) mkdir -p "$STUB_STATE/net"; touch "$STUB_STATE/net/$2" ;;
  esac
  ;;
compose)
  echo "COMPOSE_FILE=${COMPOSE_FILE:-}" >> "$STUB_LOG"
  ;;
exec)
  case "$*" in
    *psql*"-c SELECT"*) cat "$STUB_STATE/psql-select" 2>/dev/null || true ;;
  esac
  ;;
esac
exit 0
