#!/bin/sh
# Ported from the earlier shell implementation (see docs/spec/decisions.md).
# Test double for the devcontainer CLI. `up --workspace-folder <dir>` starts the project's container:
# an existing one keeps the mounts and ports it was created with (F3); a new one takes them from aw's
# Compose fragment and is labelled with the folder, as the real CLI does.
set -eu
echo "devcontainer $*" >> "$STUB_LOG"
echo "devcontainer env BUILDX_BAKE_ENTITLEMENTS_FS=${BUILDX_BAKE_ENTITLEMENTS_FS:-}" >> "$STUB_LOG"
[ "$1" = up ] || exit 1
[ ! -e "$STUB_STATE/up-fails" ] || { echo "stub: up failed" >&2; exit 1; }
dir="" config=""
shift
while [ "$#" -gt 0 ]; do
  case "$1" in
    --workspace-folder) dir="$2"; shift 2 ;;
    --config) config="$2"; shift 2 ;;
    *) shift ;;
  esac
done
config="${config:-$dir/.devcontainer/devcontainer.json}"
name="$(basename "$dir")_devcontainer"
service="$(basename "$dir")"
fragment="$dir/.devcontainer/aw.compose.yaml"
if [ -f "$config" ]; then
  s="$(sed -n 's/.*"service": *"\([^"]*\)".*/\1/p' "$config")"
  service="${s:-$service}"
fi
# Read string or array dockerComposeFile, including the generated config's multiline array.
listed=""
if [ -f "$config" ]; then
  listed="$(awk '
    /"dockerComposeFile"[ \t]*:/ { active=1; sub(/^.*"dockerComposeFile"[ \t]*:[ \t]*/, ""); array=index($0,"[") }
    active {
      line=$0
      while (match(line,/"[^"]*"/)) {
        print substr(line,RSTART+1,RLENGTH-2)
        line=substr(line,RSTART+RLENGTH)
      }
      if (!array || index($0,"]")) exit
    }' "$config")"
fi
while IFS= read -r file; do
  case "$file" in
    /*) candidate="$file" ;;
    *) candidate="$(dirname "$config")/$file" ;;
  esac
  if [ -f "$candidate" ] && grep -q '^# Written by aw;' "$candidate"; then
    fragment="$candidate"
  fi
done <<FILES
$listed
FILES
if [ -f "$fragment" ]; then
  n="$(sed -n 's/^name: *//p' "$fragment")"
  name="${n:-$name}"
fi
mkdir -p "$STUB_STATE/ps" "$STUB_STATE/inspect" "$STUB_STATE/folder" "$STUB_STATE/state"
id="c-$(basename "$dir")"
if [ -e "$STUB_STATE/ps/${name}__$service" ]; then
  id="$(cat "$STUB_STATE/ps/${name}__$service")"
  echo true > "$STUB_STATE/state/$id"
  exit 0
fi
hash=""
if [ -f "$fragment" ]; then
  hash="$(sed -n 's/.*dev.aw.config-hash: "\([^"]*\)"/\1/p' "$fragment")"
fi
bindings=""
if [ -f "$fragment" ]; then
  for p in $(sed -n 's/.*127\.0\.0\.1:\([0-9]*\):.*/\1/p' "$fragment"); do
    bindings="$bindings${bindings:+,}\"$p/tcp\":[{\"HostPort\":\"$p\"}]"
  done
fi
echo "$id" > "$STUB_STATE/ps/${name}__$service"
echo "$dir" > "$STUB_STATE/folder/$id"
echo true > "$STUB_STATE/state/$id"
cat > "$STUB_STATE/inspect/$id" <<JSON
[{"Id":"$id","State":{"Running":true,"Pid":100},"Config":{"Labels":{"devcontainer.local_folder":"$dir","dev.aw.config-hash":"$hash"}},
"Mounts":[{"Type":"bind","Source":"$dir","Destination":"$dir"}],"HostConfig":{"PortBindings":{$bindings}}}]
JSON
