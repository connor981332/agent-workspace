#!/bin/sh
# Runs after dependencies install, and as the db-reset task. Keeps data unless the lane is fresh.
set -eu

name="example_lane$AW_LANE"
sql() { psql -h localhost -U postgres -tAq -c "$1"; }

if [ -n "${AW_TASK:-}" ] || [ "${AW_FRESH:-}" = 1 ]; then
  sql "DROP DATABASE IF EXISTS \"$name\" WITH (FORCE)"
fi
if [ "$(sql "SELECT 1 FROM pg_database WHERE datname = '$name'")" != 1 ]; then
  sql "CREATE DATABASE \"$name\""
fi
"$AW_TOOL" run web npm run migrate
