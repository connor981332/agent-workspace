#!/bin/sh
# Clone the project repos into the workspace after cloning the workspace repo.
#
#   git clone <workspace repo> <WS_CHECKOUT>
#   <WS_CHECKOUT>/bin/bootstrap
#
# Dev containers are identified by their host path, so the workspace must live
# at the same path every time; this warns when it doesn't match WS_CHECKOUT.
# Existing checkouts are left alone, so this is safe to rerun.
#
# Part of the workspace core (`kit update` replaces it).

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
WS_SCRIPT="bin/bootstrap"
. "$ROOT/lib/ws/common.sh"
ws_load_conf

if [ -n "$WS_CHECKOUT" ]; then
  expected="$(eval echo "$WS_CHECKOUT")"
  [ "$ROOT" = "$expected" ] || [ "$ROOT" = "$(cd "$expected" 2>/dev/null && pwd -P)" ] ||
    ws_warn "this workspace is at $ROOT, not $expected (WS_CHECKOUT). Containers belong to their checkout path; keep using one path."
fi

[ -n "$WS_REMOTE" ] || ws_die "set WS_REMOTE in workspace.conf (repos clone from \$WS_REMOTE/<directory>.git)"

ws_projects | while read -r _alias dir _lanes _port; do
  if [ -d "$ROOT/$dir/.git" ]; then
    echo "$dir: already cloned"
  else
    git clone "$WS_REMOTE/$dir.git" "$ROOT/$dir"
  fi
done

aliases="$(ws_projects | awk '{print $1}')"
echo "Done. Start containers with:"
for a in $aliases; do echo "  bin/ws $a --up"; done
