#!/bin/sh
# Host-side setup shared by every project's dev container. Each project's
# .devcontainer/on-initialize.sh calls this from initializeCommand, so it runs
# the same way whether VS Code or bin/ws is starting the container.
#
# Run from the project directory. By convention the project's directory name is
# its Compose service, its workspace path in the container is /<name>, and its
# Compose project is <name>_devcontainer (the name VS Code derives, pinned in
# the project's compose.yaml).
#
# 1. Claim the container: remove one created from a different checkout path.
# 2. Create the shared network (WS_NETWORK) if needed.
# 3. Start the shared infrastructure (infra/compose.yaml and infra/compose.d/)
#    unless every service in WS_INFRA_SERVICES is already running.
#
# Part of the workspace core (`kit update` replaces it).

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
WS_SCRIPT="devcontainer-init"
. "$ROOT/lib/ws/common.sh"
ws_load_conf

HERE="$(pwd -P)"
NAME="$(basename "$HERE")"
PROJECT="${NAME}_devcontainer"

[ "$(dirname "$HERE")" = "$ROOT" ] ||
  ws_die "run from a project directory directly inside $ROOT (here: $HERE)"

# --- 1. Claim ----------------------------------------------------------------
# VS Code and the devcontainer CLI reuse an existing container for this Compose
# project even if it was created from another checkout (the repo moved, or a
# second clone started it). That container bind-mounts the old path, and if the
# path is gone Docker mounts an empty directory. Remove it, unless it is running
# from another checkout that still exists.
for id in $(docker ps -aq \
  --filter "label=com.docker.compose.project=$PROJECT" \
  --filter "label=com.docker.compose.service=$NAME"); do
  source_path="$(docker inspect "$id" --format \
    '{{range .Mounts}}{{if eq .Destination "'"/$NAME"'"}}{{.Source}}{{end}}{{end}}')"

  [ "$source_path" = "$HERE" ] && continue

  running="$(docker inspect "$id" --format '{{.State.Running}}')"
  if [ "$running" = "true" ] && [ -d "$source_path" ] && [ -n "$(ls -A "$source_path")" ]; then
    echo "The $PROJECT container is running from another checkout: $source_path" >&2
    echo "Stop it first (docker rm -f $id) so this checkout can own the container." >&2
    exit 1
  fi

  echo "Removing $PROJECT container $id, which mounts $source_path instead of $HERE..."
  docker rm -f "$id" >/dev/null
done

# --- 2. Network --------------------------------------------------------------
if ! docker network inspect "$WS_NETWORK" >/dev/null 2>&1; then
  echo "Creating Docker network $WS_NETWORK..."
  docker network create "$WS_NETWORK" >/dev/null
fi

# --- 3. Shared infrastructure ------------------------------------------------
# Skip Compose entirely when every long-running service is already up, which
# keeps a warm start to a single `docker ps`. Matching by name rather than by
# count means a container left over from a removed service can't stand in for a
# missing one; --remove-orphans then cleans such leftovers up. With
# WS_INFRA_SERVICES empty, Compose runs every time (correct, a little slower).
running="$(docker ps --filter "label=com.docker.compose.project=$WS_INFRA_PROJECT" \
  --filter status=running --format '{{.Label "com.docker.compose.service"}}')"
need_up=""
[ -n "$WS_INFRA_SERVICES" ] || need_up=1
for service in $WS_INFRA_SERVICES; do
  printf '%s\n' "$running" | grep -qx "$service" || { need_up=1; break; }
done
if [ -n "$need_up" ]; then
  echo "Starting shared infrastructure ($WS_INFRA_PROJECT)..."
  ws_infra_compose up -d --remove-orphans
fi
