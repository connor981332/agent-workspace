#!/bin/sh
# Forward a provider's sandbox webhooks to the main checkout or a lane.
#
#   bin/webhook-forward <provider>          # the main checkout
#   bin/webhook-forward <provider> <lane>   # a lane: its port and its worktree
#
# The provider adapter is lanes.d/webhooks/<provider>.sh. It reads the sandbox
# key from a gitignored secrets file in the main checkout (so nothing asks a
# password manager mid-session), starts the provider's forwarder on the host,
# and the signing secret it prints is written to the target checkout's
# gitignored .env.local. Neither secret is printed.
#
# From the webhook-forward module (workspace-owned; edit freely).

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
WS_SCRIPT="bin/webhook-forward"
. "$ROOT/lib/ws/common.sh"
ws_load_conf

provider="${1:-}"
lane="${2:-}"
[ -n "$provider" ] || ws_usage_die "usage: bin/webhook-forward <provider> [lane]"
adapter="$ROOT/lanes.d/webhooks/$provider.sh"
[ -f "$adapter" ] || ws_usage_die "no adapter lanes.d/webhooks/$provider.sh"

: "${WS_WEBHOOK_PROJECT:?set WS_WEBHOOK_PROJECT in workspace.conf (the alias that receives webhooks)}"
ws_project "$WS_WEBHOOK_PROJECT" || ws_die "WS_WEBHOOK_PROJECT names unknown project '$WS_WEBHOOK_PROJECT'"
[ "$P_PORT" != "-" ] || ws_die "$P_ALIAS has no port in projects"

port="$P_PORT"
if [ -n "$lane" ]; then
  ws_need_lane "$lane"
  port=$((P_PORT + $(ws_lane_get "$lane" WS_SLOT)))
fi
main="$ROOT/$P_DIR"
tree="$(ws_lane_tree "$P_DIR" "$lane")"

# The adapter defines wh_prepare <main-checkout>, wh_secret, wh_listen <url>,
# and sets WH_SECRET_VAR, WH_PATH, and WH_REDACT (a sed expression).
# shellcheck disable=SC1090
. "$adapter"
wh_prepare "$main"

secret="$(wh_secret)"
local_env="$tree/.env.local"
(
  umask 077
  touch "$local_env"
  grep -v "^$WH_SECRET_VAR=" "$local_env" > "$local_env.tmp" || true
  printf '%s=%s\n' "$WH_SECRET_VAR" "$secret" >> "$local_env.tmp"
  mv "$local_env.tmp" "$local_env"
)
unset secret

url="http://localhost:$port$WH_PATH"
echo "Forwarding $provider events to $url (secret in ${tree#"$ROOT"/}/.env.local; restart the server once)" >&2
wh_listen "$url" 2>&1 | sed -E "$WH_REDACT"
