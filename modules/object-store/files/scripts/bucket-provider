#!/bin/sh
# A bucket per lane, as an external provider (object-store module): aw calls it with a verb and a
# JSON request on standard input. Buckets are dropped by name, and it never touches another's.
set -eu
verb=$1
request=$(cat)
lane=$(printf '%s' "$request" | sed -n 's/.*"number":[[:space:]]*\([0-9]*\).*/\1/p')
bucket="uploads-lane-$lane"
garage() {
	id=$(docker ps -q --filter label=com.docker.compose.project="${AW_INFRA_PROJECT:-{{NAME}}-infra}" --filter label=com.docker.compose.service=garage | head -n 1)
	[ -n "$id" ] || { printf '{"ok":false,"error":"the object store is not running","fix":"run aw infra up"}\n'; exit 0; }
	docker exec "$id" /garage "$@" >/dev/null 2>&1
}
case $verb in
create | reset)
	garage bucket create "$bucket" || true
	garage bucket allow --read --write --owner "$bucket" --key GK000000000000000000000001 || true
	printf '{"ok":true,"names":["%s"]}\n' "$bucket"
	;;
env)
	printf '{"ok":true,"env":{"BUCKET":"%s","ENDPOINT":"http://localhost:{{PORT:3900}}"}}\n' "$bucket"
	;;
discover) printf '{"ok":true,"names":["%s"]}\n' "$bucket" ;;
drop)
	garage bucket delete --yes "$bucket" || true
	printf '{"ok":true}\n'
	;;
describe) printf '{"ok":true,"description":"a bucket per lane in Garage"}\n' ;;
*) printf '{"ok":false,"error":"%s is not supported by this provider","fix":"snapshots of buckets are not built"}\n' "$verb" ;;
esac
